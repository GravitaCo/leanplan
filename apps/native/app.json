{
  "expo": {
    "name": "Tilo",
    "slug": "tilo",
    "scheme": "tilo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2EF",
    "ios": {
      "bundleIdentifier": "fit.tilo.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fit.tilo.app",
      "adaptiveIcon": {
        "backgroundColor": "#3A2734",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Tilo reads your sleep times and your steps and walks, so it can show them next to your check-in. Nothing is shared unless you choose to.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "owner": "gravita-co",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4a22860f-a4a9-4472-99a2-6a4d22426b23"
      }
    }
  }
}
