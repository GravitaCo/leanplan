{
  "name": "tilo-native",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test:platform": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-platform.mjs",
    "tokens": "node scripts/tokens.mjs",
    "check:tokens": "node scripts/tokens.mjs --check",
    "bundle:ios": "expo export --platform ios --output-dir dist-check --clear",
    "doctor": "expo-doctor",
    "test": "node scripts/run-tests.mjs",
    "test:reminders": "npx --yes esbuild@0.21.5 scripts/test-reminders.ts --bundle --platform=node --log-level=error --alias:@=../../src --alias:react-native=./scripts/fakes/react-native.ts --alias:expo=./scripts/fakes/expo.ts --alias:expo-notifications=./scripts/fakes/expo-notifications.ts --alias:expo-application=./scripts/fakes/expo-application.ts --resolve-extensions=.native.ts,.ts,.tsx,.js,.mjs,.json --define:import.meta.env={} --outfile=node_modules/.cache/test-reminders.cjs && node node_modules/.cache/test-reminders.cjs",
    "test:extension": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-extension.mjs",
    "test:train": "npx --yes esbuild@0.21.5 scripts/test-train.ts --bundle --platform=node --log-level=error --alias:@=../../src --alias:react-native=./scripts/fakes/react-native.ts --alias:expo=./scripts/fakes/expo.ts --alias:expo-notifications=./scripts/fakes/expo-notifications.ts --alias:expo-application=./scripts/fakes/expo-application.ts --resolve-extensions=.native.ts,.ts,.tsx,.js,.mjs,.json --define:import.meta.env={} --outfile=node_modules/.cache/test-train.cjs && node node_modules/.cache/test-train.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.2",
    "@supabase/supabase-js": "^2.119.0",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.23",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "immer": "^11.2.9",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "typescript": "~6.0.3"
  }
}
